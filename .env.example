# API Configuration
PROJECT_NAME="FastAPI Open LLM Microservice"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & JWT Authentication
SECRET_KEY="super-secret-jwt-key-change-in-production-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Provider Settings
# Backend options: "local_mock", "ollama", "huggingface", "openrouter"
LLM_BACKEND="local_mock"
DEFAULT_MODEL="llama3-open-8b"
OLLAMA_BASE_URL="http://localhost:11434"
HUGGINGFACE_API_KEY=""
OPENROUTER_API_KEY=""

# AI Rate Limiting & Usage Controls
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_TOKENS_PER_MINUTE=10000
